{
  "openapi": "3.1.0",
  "info": {
    "title": "Franklin Tarot API",
    "version": "1.0.0",
    "description": "Read-only tarot card catalog and spread definitions for apps and AI agents. The calling app draws cards and owns the reading. Tarot is for symbolic reflection, not factual prediction."
  },
  "servers": [{ "url": "https://api.example.com", "description": "Replace with your deployment URL" }],
  "paths": {
    "/health": { "get": { "operationId": "health", "responses": { "200": { "description": "Service status" } } } },
    "/api/v1/cards": { "get": { "operationId": "searchTarotCards", "parameters": [{ "name": "q", "in": "query", "schema": { "type": "string" } }, { "name": "arcana", "in": "query", "schema": { "enum": ["MAJOR", "MINOR"] } }, { "name": "suit", "in": "query", "schema": { "enum": ["WANDS", "CUPS", "SWORDS", "PENTACLES"] } }, { "name": "locale", "in": "query", "schema": { "enum": ["en", "zh-CN"], "default": "zh-CN" } }], "responses": { "200": { "description": "Every matching card. Each card has arcana, suit (null for major arcana) and rank: 0–21 for major arcana, 1–10 for pips, 11–14 for Page, Knight, Queen and King." }, "400": { "$ref": "#/components/responses/ApiError" } } } },
    "/api/v1/cards/random": { "get": { "operationId": "getRandomTarotCards", "description": "Returns n distinct cards in random order. Cards carry no orientation; the caller decides upright or reversed.", "parameters": [{ "name": "n", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 78, "default": 1 } }, { "name": "locale", "in": "query", "schema": { "enum": ["en", "zh-CN"], "default": "zh-CN" } }], "responses": { "200": { "description": "n distinct random cards" }, "400": { "$ref": "#/components/responses/ApiError" } } } },
    "/api/v1/cards/{id}": { "get": { "operationId": "getTarotCard", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string", "examples": ["maj00"] } }, { "name": "locale", "in": "query", "schema": { "enum": ["en", "zh-CN"], "default": "zh-CN" } }], "responses": { "200": { "description": "Bilingual card data and versioned image URLs" }, "404": { "$ref": "#/components/responses/ApiError" } } } },
    "/api/v1/spreads": { "get": { "operationId": "listTarotSpreads", "parameters": [{ "name": "locale", "in": "query", "schema": { "enum": ["en", "zh-CN"], "default": "zh-CN" } }], "responses": { "200": { "description": "11 real spreads with localized labels and interpretation goals. Each item includes layout.type, positions ordered by draw index (null for linear layouts), and cardPools: one pool per position (FULL, MAJOR, MINOR_PIP, COURT, SUIT_WANDS, SUIT_CUPS, SUIT_SWORDS or SUIT_PENTACLES)." } } } }
  },
  "components": {
    "schemas": {
      "ApiError": { "type": "object", "required": ["error"], "properties": { "error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "details": {} } } } }
    },
    "responses": { "ApiError": { "description": "Structured API error", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } } } }
  }
}
