{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "allowJs": true
  },
  "include": [
    "src",
    "mcp",
    "tests",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    ".api-deploy",
    "mcp/dist"
  ]
}
